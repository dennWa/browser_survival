{
  "name": "browser-survival",
  "version": "0.14.0",
  "description": "Top-Down-Survival im Browser – autoritativer Server, WebSocket-Mehrspieler",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/node/start.js",
    "start:gast": "node server/node/start.js --gast",
    "konto": "node server/werkzeuge/kontoAnlegen.js",
    "musik:index": "node werkzeuge/musik/indexieren.mjs",
    "sounds": "node werkzeuge/audio/indexieren.mjs",
    "eigene:index": "node werkzeuge/assets/eigene_index.mjs",
    "eigene:vorschau": "node werkzeuge/assets/eigene_vorschau.mjs",
    "assets:3d": "node werkzeuge/assets/baue_3d.mjs",
    "assets:figuren": "node werkzeuge/assets/figuren/baue_figuren.mjs",
    "karte:export": "node werkzeuge/karten/tiled.mjs export",
    "karte:import": "node werkzeuge/karten/tiled.mjs import",
    "rauchtest": "node werkzeuge/test/rauchtest.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "karte:editor": "node werkzeuge/karten/editorImport.mjs",
    "rauchtest:r23": "node werkzeuge/test/rauchtestRunde23.mjs",
    "rauchtest:editor": "node werkzeuge/test/editorRauchtest.mjs",
    "editor:lokal": "node werkzeuge/editor/lokalerServer.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild@0.25.10": true
  }
}
